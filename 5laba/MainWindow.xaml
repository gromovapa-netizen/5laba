<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лаба 5 - Списки + CRUD" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Имя"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль"/>
            <TextBox x:Name="PasswordBox" Margin="0,0,0,10"/>

            <TextBlock Text="Телефон"/>
            <TextBox x:Name="PhoneBox" Margin="0,0,0,10"/>

            <TextBlock Text="Роль"/>
            <ComboBox x:Name="RoleComboBox" Margin="0,0,0,10" SelectedIndex="0">
                <ComboBoxItem Content="Пользователь"/>
                <ComboBoxItem Content="Менеджер"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>

            <TextBlock Text="Дата рождения"/>
            <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,20"/>

            
            <Button x:Name="SaveButton" Content="Добавить" Click="SaveButton_Click" Height="30"/>
        </StackPanel>

       
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0">
                <TabItem Header="Все пользователи">
                    <ListBox x:Name="AllUsersList" SelectionChanged="UserList_SelectionChanged"/>
                </TabItem>
                <TabItem Header="Пользователи">
                    <ListBox x:Name="UsersList" SelectionChanged="UserList_SelectionChanged"/>
                </TabItem>
                <TabItem Header="Менеджеры">
                    <ListBox x:Name="ManagersList" SelectionChanged="UserList_SelectionChanged"/>
                </TabItem>
                <TabItem Header="Администраторы">
                    <ListBox x:Name="AdminsList" SelectionChanged="UserList_SelectionChanged"/>
                </TabItem>
            </TabControl>

            
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Width="100" Margin="5" IsEnabled="False"/>
                <Button x:Name="EditButton" Content="Изменить" Click="EditButton_Click" Width="100" Margin="5" IsEnabled="False"/>
                <Button x:Name="AddNewButton" Content="Добавить" Click="AddNewButton_Click" Width="100" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
